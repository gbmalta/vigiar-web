{
  "name": "vigiar-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "node scripts/verify-data.mjs && node scripts/verify-analytics.mjs",
    "check:meeting": "node --experimental-strip-types scripts/verify-health-meeting.mjs",
    "review:meeting": "node scripts/review-health-meeting.mjs",
    "lint": "oxlint --deny-warnings components/atlas.tsx components/geo-map.tsx components/notification-trend.tsx components/dag-overview.tsx components/article-metrics.tsx hooks/use-map-tools.ts lib src vite.config.ts",
    "test:science": "python -m unittest discover -s scripts -p test_analytics.py -v",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "3.8.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "shadcn": "4.18.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
